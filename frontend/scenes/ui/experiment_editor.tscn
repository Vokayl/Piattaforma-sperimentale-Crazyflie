[connection signal="pressed" from="Droni/Fields/AddDroneRow/RemoveDrone" to="." method="_remove_drone"]
[connection signal="toggled" from="Droni/Fields/DroneProperties/DroneEnabled" to="." method="_enabled_changed"]
[connection signal="item_selected" from="Missione/Fields/MissionProperties/WaypointList" to="." method="_select_waypoint"]
[connection signal="pressed" from="Missione/Fields/MissionProperties/AddWaypointRow/AddWaypoint" to="." method="_add_waypoint"]
[connection signal="pressed" from="Missione/Fields/MissionProperties/AddWaypointRow/RemoveWaypoint" to="." method="_remove_waypoint"]
[connection signal="pressed" from="Missione/Fields/MissionProperties/AddWaypointRow/WaypointUp" to="." method="_waypoint_up"]
[connection signal="pressed" from="Missione/Fields/MissionProperties/AddWaypointRow/WaypointDown" to="." method="_waypoint_down"]
[connection signal="pressed" from="Scenario/Fields/AddBounds" to="." method="_add_bounds"]
[connection signal="item_selected" from="Scenario/Fields/ObstacleList" to="." method="_select_obstacle"]
[connection signal="pressed" from="Scenario/Fields/AddObstacleRow/AddObstacle" to="." method="_add_obstacle"]
[connection signal="pressed" from="Scenario/Fields/AddObstacleRow/RemoveObstacle" to="." method="_remove_obstacle"]
